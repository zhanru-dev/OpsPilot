NODE_ENV="development"
DEMO_SEED_ALLOWED=false
DATABASE_URL="postgresql://opspilot:opspilot@localhost:5544/opspilot?schema=public"
API_HOST="0.0.0.0"
API_PORT=4100
WEB_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4100/api/v1"
JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-long-random-refresh-secret"
COOKIE_SECURE=false
COOKIE_SAME_SITE="lax"
TRUST_PROXY=false
REDIS_URL="redis://localhost:6379"
S3_ENDPOINT="http://localhost:9000"
S3_PUBLIC_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="opspilot-media"
S3_ACCESS_KEY="opspilot"
S3_SECRET_KEY="opspilot-local-storage"
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=true
MEDIA_UPLOAD_MAX_BYTES=104857600
MEDIA_MAX_DURATION_SECONDS=300
MEDIA_UPLOAD_URL_TTL_SECONDS=600
MEDIA_PLAYBACK_URL_TTL_SECONDS=300
MEDIA_DEMO_RETENTION_HOURS=24
WEBHOOK_SECRET_ENCRYPTION_KEY="replace-with-a-long-random-webhook-encryption-key"
WEBHOOK_RECEIVER_BASE_URL="http://localhost:4100/api/v1/demo/webhook-receiver"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5-mini"
